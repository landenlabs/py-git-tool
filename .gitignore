# .gitignore - LanDen Labs Python projects (shared across all py-* repos)

# Byte-compiled / cache
__pycache__/
*.py[cod]
*$py.class
*.so

# Distribution / packaging
.Python
build/
dist/
*.egg-info/
*.egg
MANIFEST

# PyInstaller: *.spec is intentionally NOT ignored -- several repos commit
# their .spec file and build it via build.sh. Delete stray generated specs.

# PyBuilder
.pybuilder/
target/

# Translations
*.mo
*.pot

# Virtual environments
.venv
venv/
env/
ENV/
env.bak/
venv.bak/

# Secrets / local config -- never commit these
.env
.envrc
.pypirc
serviceAccountKey.json
*serviceAccountKey*.json

# Unit tests / coverage
.coverage
.coverage.*
htmlcov/
.pytest_cache/
.tox/
.nox/

# Type checkers / linters
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/
.ruff_cache/

# IDEs / tools
.idea/
.vscode/
.claude/
.claude/**

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Local scratch / runtime data
tmp/
.legacy
.legacy/**
PROFILE_DIR/
